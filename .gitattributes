# Normalize line endings to LF in the repo; let git check out with OS endings
* text=auto

# Force LF for all code/config regardless of OS
*.go      text eol=lf
*.ts      text eol=lf
*.svelte  text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.txt     text eol=lf
*.env*    text eol=lf
*.toml    text eol=lf

# Binaries — no line-ending processing
*.ttf     binary
*.woff    binary
*.woff2   binary
*.jpg     binary
*.jpeg    binary
*.png     binary
*.gif     binary
*.ico     binary
*.svg     binary
*.mp3     binary
*.webp    binary
